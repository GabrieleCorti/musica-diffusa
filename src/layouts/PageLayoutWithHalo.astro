---
import GlobalStyles from "../components/GlobalStyles.astro";
import Nav from "../components/TopNavbar.astro";
import Footer from "../components/Footer.astro";
---

<style>
  .w-full {
    width: 100%;
  }
</style>
<GlobalStyles />
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Inria+Serif:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Musica Diffusa</title>
  </head>
  <body>
    <Nav />
    <main>
      <div class="page-content">
        <slot />
      </div>
      <slot name="full-width-halo" />
    </main>
    <Footer />
  </body>
</html>
