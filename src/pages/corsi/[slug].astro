---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/PageLayout.astro";
import GlobalStyles from "../../components/GlobalStyles.astro";
import Cover from "../../components/Cover.astro";
import Button from "../../components/LinkButton.astro";
export async function getStaticPaths() {
  const course = await getCollection("corsi");
  return course.map((entry) => ({
    params: { slug: entry.slug },
    props: {
      course: entry,
    },
  }));
}

const {
  course: {
    data: { titolo, pic },
    body,
  },
} = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/docenti/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);
const instrumentPic = images[pic];
---

<style>
  .content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8rem 0 4rem 0;
  }
  .title {
    font-size: 0.75rem;
  }
  h1 {
    font-size: 6rem;
    margin-bottom: 2rem;
  }
  .description {
    font-size: 1.125rem;
    line-height: 1.625rem;
    margin-bottom: 2rem;
    max-width: 32rem;
  }
  .img-wrapper {
    overflow: hidden;
    border: 1px solid var(--color-primary);
    border-radius: 999px;
    width: 380px;
    height: 380px;
    box-shadow: 0px 0px 40px 32px #be233a52;
  }
</style>
<GlobalStyles />
<BaseLayout>
  <div class="content">
    <div>
      <p class="title">CORSO</p>
      <h1>{titolo}</h1>
      <p class="description">{body}</p>
      <Button>Contattaci</Button>
    </div>
    <div class="img-wrapper">
      <Image
        loading="eager"
        fetchpriority="high"
        src={instrumentPic.default}
        alt={`Foto del corso di ${titolo}`}
        height={390}
        width={390}
      />
    </div>
  </div>
  <Cover title="Sei pronto ad iniziare il tuo percorso"
    >Richiedi informazioni</Cover
  >
</BaseLayout>
