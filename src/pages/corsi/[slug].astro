---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/PageLayout.astro";
import Cover from "../../components/Cover.astro";
import Button from "../../components/LinkButton.astro";
import { WHATSAPP_LINK } from "../../config/contact";
export async function getStaticPaths() {
  const course = await getCollection("corsi");
  return course.map((entry) => ({
    params: { slug: entry.slug },
    props: {
      course: entry,
    },
  }));
}

const {
  course: {
    data: { titolo, pic },
    body,
  },
} = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/corsi/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);
const instrumentPic = images[pic];
const isGordon = titolo.toLocaleLowerCase().includes("gordon");
---

<style>
  .content {
    padding: 8rem 0 4rem 0;
  }
  .title {
    font-size: 0.75rem;
  }
  h1 {
    font-size: 3.75rem;
    margin-bottom: 0.5rem;
  }
  .instructor {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-base);
    margin-bottom: 1.5rem;
  }
  .description {
    font-size: 1.125rem;
    line-height: 1.625rem;
    margin-bottom: 2rem;
    max-width: 32rem;
  }
  .img-wrapper {
    position: relative;
    border-radius: 999px;
    width: 200px;
    height: 200px;
    margin: 4rem auto 0;
  }

  .img-wrapper::before {
    content: "";
    position: absolute;
    inset: -2.75rem;
    border-radius: 999px;
    background: radial-gradient(
      circle,
      var(--color-primary) 0%,
      color-mix(in srgb, var(--color-primary) 70%, transparent) 45%,
      transparent 75%
    );
    filter: blur(2rem);
    z-index: -1;
  }

  .img-wrapper img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 1px solid var(--color-primary);
    border-radius: 999px;
  }

  .responsive-btn {
    width: 100%;
    text-align: center;
  }

  @media screen and (min-width: 640px) {
    .responsive-btn {
      width: fit-content;
    }
    .img-wrapper {
      width: 260px;
      height: 260px;
    }
  }

  @media screen and (min-width: 768px) {
    .content {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8rem 0 4rem 0;
    }
    h1 {
      font-size: 6rem;
      margin-bottom: 0.5rem;
    }

    .img-wrapper {
      margin: 0;
      width: 300px;
      height: 300px;
    }
  }

  @media screen and (min-width: 1000px) {
    .img-wrapper {
      width: 390px;
      height: 390px;
    }
  }
</style>
<BaseLayout>
  <div class="content">
    <div>
      <p class="title">CORSO</p>
      <h1>{titolo}</h1>
      {isGordon && <p class="instructor">con Luca Mauri</p>}
      <p class="description">{body}</p>
      <Button
        class="responsive-btn"
        href={WHATSAPP_LINK}
        target="_blank"
        rel="noopener noreferrer"
      >
        Contattaci
      </Button>
    </div>
    <div class="img-wrapper">
      <Image
        loading="eager"
        fetchpriority="high"
        src={instrumentPic.default}
        alt={`Foto del corso di ${titolo}`}
        height={390}
        width={390}
        densities={[1, 2]}
      />
    </div>
  </div>
  <Cover
    slot="full-width"
    title="Sei pronto ad iniziare il tuo percorso"
    linkProps={{
      href: WHATSAPP_LINK,
      target: "_blank",
      rel: "noopener noreferrer",
    }}
  >
    Richiedi informazioni
  </Cover>
</BaseLayout>
