---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/PageLayout.astro";
import SocialLink from "../../components/SocialLink.astro";
import Cover from "../../components/Cover.astro";
import Music from "@lucide/astro/icons/music-2";
import { WHATSAPP_LINK } from "../../config/contact";
import coverImg from "../../assets/cover/cover_2.png";

export async function getStaticPaths() {
  const teachers = await getCollection("docenti");

  return teachers.map((entry) => ({
    params: { slug: entry.id },
    props: {
      teacher: entry,
    },
  }));
}

const {
  teacher: {
    data: {
      nome,
      strumento,
      titolo,
      proPic: teacherImage,
      instagram,
      youtube,
      website,
      facebook,
    },
    body,
  },
} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/docenti/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);

const proPic = images[teacherImage];
---

<style>
  .content {
    display: flex;
    gap: 4rem;
  }
  aside {
    display: none;
  }
  .link-wrapper {
    position: sticky;
    top: 8rem;
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: 1rem;
  }
  .link-wrapper::before,
  .link-wrapper::after {
    display: block;
    content: "";
    width: 1px;
    height: 4rem;
    background-color: var(--color-border);
  }
  .title-wrapper {
    display: flex;
    padding: 8rem 0 4rem 0;
    border-bottom: 1px solid var(--color-border);
    gap: 2rem;
  }
  .title-wrapper .avatar {
    --avatar-size: 175px;
  }
  .title {
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }
  h1 {
    font-size: 3rem;
  }
  p:has(.musical-note) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .musical-note {
    color: var(--color-primary);
    width: 14px;
    aspect-ratio: 1;
  }
  .bio {
    margin-top: 4rem;
    margin-bottom: 3rem;
    font-size: 1.125rem;
    line-height: 1.625rem;
  }
  .md-social {
    display: flex;
    gap: 1rem;
    align-items: center;
    width: 100%;
    border-top: 1px solid var(--color-border);
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  @media screen and (min-width: 786px) {
    h1 {
      font-size: 4.5rem;
    }
    aside {
      display: block;
      position: relative;
      padding-bottom: 4rem;
    }
    .bio {
      margin-bottom: 4rem;
    }
    .md-social {
      display: none;
    }
  }
</style>
<BaseLayout>
  <div class="content">
    {(instagram || youtube || website || facebook) && (
      <aside>
        <div class="link-wrapper">
          {instagram && (
            <SocialLink type="ig" href={instagram} target="_blank" rel="noopener noreferrer" />
          )}
          {youtube && (
            <SocialLink type="yt" href={youtube} target="_blank" rel="noopener noreferrer" />
          )}
          {website && (
            <SocialLink type="www" href={website} target="_blank" rel="noopener noreferrer" />
          )}
          {facebook && (
            <SocialLink type="fb" href={facebook} target="_blank" rel="noopener noreferrer" />
          )}
        </div>
      </aside>
    )}
    <div>
      <div class="title-wrapper">
        <div class="avatar avatar--glow">
          <Image
            loading="eager"
            fetchpriority="high"
            src={proPic.default}
            alt={`Foto profilo di ${nome}`}
            height={175}
            width={175}
            fit="cover"
            position="center"
          />
        </div>
        <div>
          <p class="title">{titolo}</p>
          <h1>{nome}</h1>
          <p><Music class="musical-note" /> {strumento}</p>
        </div>
      </div>
      <p class="bio max-text-w">{body}</p>
      {(instagram || youtube || website || facebook) && (
        <section class="md-social">
          <p>Social:</p>
          {instagram && (
            <SocialLink type="ig" href={instagram} target="_blank" rel="noopener noreferrer" />
          )}
          {youtube && (
            <SocialLink type="yt" href={youtube} target="_blank" rel="noopener noreferrer" />
          )}
          {website && (
            <SocialLink type="www" href={website} target="_blank" rel="noopener noreferrer" />
          )}
          {facebook && (
            <SocialLink type="fb" href={facebook} target="_blank" rel="noopener noreferrer" />
          )}
        </section>
      )}
    </div>
  </div>
  <Cover
    backgroundImage={coverImg}
    slot="full-width"
    linkProps={{
      href: WHATSAPP_LINK,
      target: "_blank",
      rel: "noopener noreferrer",
    }}
  >
    Prenota una lezione
  </Cover>
</BaseLayout>
