---
import { getCollection } from "astro:content";
import HaloLayout from "../../layouts/PageLayoutWithHalo.astro";
import TeamBaloon from "../../components/TeamBaloon.astro";
import TeamMobileList from "../../components/TeamMobileList.astro";
import Cover from "../../components/Cover.astro";
import { WHATSAPP_LINK } from "../../config/contact";

const teachers = await getCollection("docenti");
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/docenti/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);

const teacherItems = teachers.map(({ slug, data: { nome, strumento, proPic } }) => ({
  name: nome,
  proPic: images[proPic].default,
  instrument: strumento,
  href: `/team/${slug}`,
}));
---

<style>
  .desktop-team {
    display: none;
  }
  @media screen and (min-width: 768px) {
    .content {
      padding-top: calc(100vh + 1.5rem);
    }
    .desktop-team {
      display: block;
    }
  }
  .title-container {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    z-index: 10;
  }
  .second-title {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }
  h1 {
    font-size: 10rem;
    font-family: var(--text-body);
  }
  h1::after {
    content: "";
    display: block;
    width: 25%;
    height: 1px;
    background-color: var(--color-primary);
    transform: translate(150%);
  }
  .scattered {
    position: relative;
    width: 100%;
    height: 100vh;
    margin-bottom: 10rem;
    z-index: 1;
  }
  .scattered > :global(.teacher-link) {
    position: absolute;
    transform: translate(-50%, -50%);
  }
  .scattered > :global(.teacher-link:nth-child(1)) {
    top: 18%;
    left: 18%;
  }
  .scattered > :global(.teacher-link:nth-child(2)) {
    top: 12%;
    left: 72%;
  }
  .scattered > :global(.teacher-link:nth-child(3)) {
    top: 55%;
    left: 8%;
  }
  .scattered > :global(.teacher-link:nth-child(4)) {
    top: 48%;
    left: 58%;
  }
  .scattered > :global(.teacher-link:nth-child(5)) {
    top: 82%;
    left: 23%;
  }
  .scattered > :global(.teacher-link:nth-child(6)) {
    top: 75%;
    left: 82%;
  }
  .scattered > :global(.teacher-link:nth-child(7)) {
    top: 38%;
    left: 88%;
  }
  .scattered > :global(.teacher-link:nth-child(8)) {
    top: 95%;
    left: 52%;
  }

  .scattered > :global(.teacher-link) {
    opacity: 0;
    translate: 0 20px;
    transition:
      opacity 0.9s ease,
      translate 0.9s ease;
  }
  .scattered > :global(.teacher-link.visible) {
    opacity: 1;
    translate: 0 0;
  }
</style>
<HaloLayout>
  <div class="content">
    <div class="desktop-team">
      <div class="title-container">
        <p class="second-title">INCONTRA</p>
        <h1>IL TEAM</h1>
      </div>
      <div class="scattered">
        {teacherItems.map((teacher) => <TeamBaloon {...teacher} />)}
      </div>
    </div>
    <TeamMobileList teachers={teacherItems} />
  </div>
  <Cover
    slot="full-width-halo"
    title="Vuoi studiare con noi?"
    linkProps={{
      href: WHATSAPP_LINK,
      target: "_blank",
      rel: "noopener noreferrer"
    }}
  >
    Contattaci
  </Cover>
</HaloLayout>
<script>
  const titleContainer =
    document.querySelector<HTMLElement>(".title-container");
  const cover = document.querySelector<HTMLElement>(".cover");

  let pinned = false;

  function pin() {
    if (pinned || !titleContainer) return;
    pinned = true;
    const scrollY = window.scrollY;
    const centerY = scrollY + window.innerHeight / 2;
    const centerX = document.documentElement.clientWidth / 2;
    titleContainer.style.position = "absolute";
    titleContainer.style.top = `${centerY}px`;
    titleContainer.style.left = `${centerX}px`;
    titleContainer.style.transform = "translate(-50%, -50%)";
  }

  function unpin() {
    if (!pinned || !titleContainer) return;
    pinned = false;
    titleContainer.style.position = "";
    titleContainer.style.top = "";
    titleContainer.style.left = "";
    titleContainer.style.transform = "";
  }

  function onScroll() {
    if (!cover) return;
    const coverTop = cover.getBoundingClientRect().top;
    if (coverTop <= window.innerHeight) {
      pin();
    } else {
      unpin();
    }
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const links = document.querySelectorAll<HTMLElement>(
    ".scattered .teacher-link",
  );

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const index = Number(el.dataset.index);
          setTimeout(() => el.classList.add("visible"), index * 120);
          observer.unobserve(el);
        }
      });
    },
    { threshold: 0.1 },
  );

  links.forEach((link, i) => {
    link.dataset.index = String(i);
    observer.observe(link);
  });
</script>
