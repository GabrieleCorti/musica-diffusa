---
const pdfUrl = "/docs/statuto-associazione-culturale-musica-diffusa.pdf";
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <title>Statuto - Musica Diffusa</title>
    <style>
      html, body {
        margin: 0;
        height: 100%;
      }
      iframe {
        width: 100%;
        height: 100%;
        border: none;
      }
    </style>
  </head>
  <body>
    <iframe src={pdfUrl} title="Statuto Associazione Culturale Musica Diffusa">
      <a href={pdfUrl} target="_blank" rel="noopener noreferrer">
        Scarica lo statuto in formato PDF
      </a>
    </iframe>
  </body>
</html>
