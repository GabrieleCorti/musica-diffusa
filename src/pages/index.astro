---
import BaseLayout from "../layouts/PageLayout.astro";
import CoursesSection from "../components/CoursesSection.astro";
import LocationsSection from "../components/LocationsSection.astro";
import Cover from "../components/Cover.astro";
import Hero from "../components/Hero.astro";
import { getCollection } from "astro:content";
import { WHATSAPP_LINK } from "../config/contact";
import coverImg from "../assets/cover/cover_3.png";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/docenti/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);
const courseImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/corsi/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);
const courses = await getCollection("corsi");
---

<BaseLayout>
  <Hero slot="full-width-top" />
  <Cover
    linkProps={{
      href: WHATSAPP_LINK,
      target: "_blank",
      rel: "noopener noreferrer",
    }}
    slot="full-width-top"
    title="ISCRIZIONI APERTE"
    subtitle="A.A 2026-2027"
    backgroundImage={coverImg}
  >
    Contattaci
  </Cover>
  <LocationsSection
    slot="full-width-top"
    locations={[
      {
        name: "Pessano con Bornago",
        image: images["/src/assets/docenti/andrea-tremolada.png"].default,
      },
      {
        name: "Vimercate",
        image: images["/src/assets/docenti/andrea-tremolada.png"].default,
      },
      {
        name: "Carugate",
        image: images["/src/assets/docenti/andrea-tremolada.png"].default,
      },
      {
        name: "Pozzo d'Adda",
        image: images["/src/assets/docenti/andrea-tremolada.png"].default,
      },
    ]}
  />
  <CoursesSection courses={courses} images={courseImages} />
  <Cover
    slot="full-width"
    title="Incontra il Team"
    linkProps={{
      href: "/team",
    }}
  >
    Scopri chi siamo
  </Cover>
</BaseLayout>
