---
import BaseLayout from "../layouts/PageLayout.astro";
import CoursesSection from "../components/CoursesSection.astro";
import LocationsSection from "../components/LocationsSection.astro";
import Cover from "../components/Cover.astro";
import { getCollection } from "astro:content";
import { WHATSAPP_LINK } from "../config/contact";
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/docenti/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);
const courses = await getCollection("corsi");
---

<BaseLayout>
  <div slot="full-width-top" style="display: flex; align-items: center; justify-content: center; height: 800px;">
    <h2>Hero placeholder</h2>
  </div>
  <Cover
    linkProps={{
      href: WHATSAPP_LINK,
      target: "_blank",
      rel: "noopener noreferrer",
    }}
    slot="full-width-top"
    title="ISCRIZIONI APERTE"
    subtitle="A.A 2026-2027"
  >
    Contattaci
  </Cover>
  <LocationsSection
    slot="full-width-top"
    locations={[
      {
        name: "Pessano con Bornago",
        image: images["/src/assets/docenti/andrea-tremolada.jpg"].default,
      },
      {
        name: "Vimercate",
        image: images["/src/assets/docenti/andrea-tremolada.jpg"].default,
      },
      {
        name: "Carugate",
        image: images["/src/assets/docenti/andrea-tremolada.jpg"].default,
      },
      {
        name: "Pozzo d'Adda",
        image: images["/src/assets/docenti/andrea-tremolada.jpg"].default,
      },
    ]}
  />
  <CoursesSection courses={courses} images={images} />
  <Cover
    slot="full-width"
    title="Incontra il Team"
    linkProps={{
      href: "/team",
    }}
  >
    Scopri chi siamo
  </Cover>
</BaseLayout>
