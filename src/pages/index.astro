---
import BaseLayout from "../layouts/PageLayout.astro";
import CoursesSection from "../components/CoursesSection.astro";
import TownLocationsSection from "../components/TownLocationsSection.astro";
import Cover from "../components/Cover.astro";
import Hero from "../components/Hero.astro";
import AboutSection from "../components/AboutSection.astro";
import { getCollection } from "astro:content";
import { WHATSAPP_LINK } from "../config/contact";
import coverImg from "../assets/cover/cover_3.png";

const courseImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/corsi/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);
const courses = await getCollection("corsi");
---

<BaseLayout>
  <Hero slot="full-width-top" />
  <AboutSection slot="full-width-top" />
  <Cover
    linkProps={{
      href: WHATSAPP_LINK,
      target: "_blank",
      rel: "noopener noreferrer",
    }}
    slot="full-width-top"
    title="ISCRIZIONI APERTE"
    subtitle="A.A 2026-2027"
    backgroundImage={coverImg}
  >
    Contattaci
  </Cover>
  <TownLocationsSection
    slot="full-width-top"
    locations={[
      {
        name: "Pessano con Bornago",
        streets: ["Via Provinciale, 15", "Piazza della Resistenza, 1", "Via Giotto, 24"],
      },
      {
        name: "Vimercate",
        streets: ["Via don Sturzo, 1"],
      },
      {
        name: "Carugate",
        streets: ["Via Garibaldi, 26"],
      },
      {
        name: "Pozzo d'Adda",
        streets: ["Via Colombo, 18"],
      },
    ]}
  />
  <CoursesSection courses={courses} images={courseImages} />
  <Cover
    slot="full-width"
    title="Incontra il Team"
    linkProps={{
      href: "/team",
    }}
  >
    Scopri chi siamo
  </Cover>
</BaseLayout>
