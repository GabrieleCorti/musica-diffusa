---
import BaseLayout from "../layouts/PageLayout.astro";
import CourseHero from "../components/CourseHero.astro";
import LocationsSection from "../components/LocationsSection.astro";
import Cover from "../components/Cover.astro";
import { getCollection } from "astro:content";
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/docenti/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);
const courses = await getCollection("corsi");
const orderedCourses = courses.sort((a, b) => {
  const aIsGordon = a.data.titolo.toLocaleLowerCase().includes("gordon");
  const bIsGordon = b.data.titolo.toLocaleLowerCase().includes("gordon");
  if (aIsGordon && !bIsGordon) {
    return 1;
  }
  if (!aIsGordon && bIsGordon) {
    return -1;
  }
  return a.data.titolo.localeCompare(b.data.titolo);
});
---
<style>
  .title {
    font-size: 2.5rem;
  }
</style>
<BaseLayout>
  <Cover
    slot="full-width-top"
    title="ISCRIZIONI APERTE"
    subtitle="A.A 2026-2027"
  >
    Contattaci
  </Cover>
  <LocationsSection
    slot="full-width-top"
    locations={[
      {
        name: "Pessano",
        image: images["/src/assets/docenti/andrea-tremolada.jpg"].default,
      },
      {
        name: "Pessano",
        image: images["/src/assets/docenti/andrea-tremolada.jpg"].default,
      },
      {
        name: "Pessano",
        image: images["/src/assets/docenti/andrea-tremolada.jpg"].default,
      },
      {
        name: "Pessano",
        image: images["/src/assets/docenti/andrea-tremolada.jpg"].default,
      },
    ]}
  />
  <h2 class="title">I Nostri Corsi</h2>
  <ul>
    {
      orderedCourses.map((course) => (
        <li>
          <CourseHero
            title={course.data.titolo}
            image={images[course.data.pic].default}
            href={`/corsi/${course.slug}`}
            isGordon={course.data.titolo.toLocaleLowerCase().includes("gordon")}
          />
        </li>
      ))
    }
  </ul>
  <Cover slot="full-width" title="Incontra il Team">Scopri chi siamo</Cover>
</BaseLayout>
