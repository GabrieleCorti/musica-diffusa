---
import Button from "./LinkButton.astro";
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<style>
  .cover {
    width: 100%;
    height: 426px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
    justify-content: center;
    background: var(--color-primary);
    padding: 0 1.5rem;
  }
  .cover-title {
    font-size: 2.75rem;
    text-align: center;
  }

  @media screen and (min-width: 786px) {
    .cover-title {
      font-size: 4rem;
    }
  }
</style>
<section class="cover">
  {title && <h3 class="cover-title">{title}</h3>}
  <Button type="foreground"><slot /></Button>
</section>
