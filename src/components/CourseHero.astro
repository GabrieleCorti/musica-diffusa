---
import { Image } from "astro:assets";

export interface Props {
  title: string;
  image: { default: ImageMetadata };
}

const { title, image } = Astro.props;
---

<style>
  .course-hero {
    width: 100%;
    background-color: var(--color-bg);
    padding: 2rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-border);
  }

  .label {
    font-size: 0.75rem;
    color: var(--color-base);
    margin-bottom: 0.25rem;
    font-family: var(--text-body);
    text-transform: capitalize;
  }

  .title {
    font-size: 2.5rem;
    font-family: var(--text-serif);
    color: var(--color-foreground);
    font-weight: 700;
  }

  .img-wrapper {
    overflow: hidden;
    border-radius: 999px;
    width: 96px;
    height: 96px;
    flex-shrink: 0;
  }

  .img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<div class="course-hero">
  <div>
    <p class="label">Corso</p>
    <h2 class="title">{title}</h2>
  </div>
  <div class="img-wrapper">
    <Image src={image.default} alt={`Foto del corso di ${title}`} width={96} height={96} />
  </div>
</div>
