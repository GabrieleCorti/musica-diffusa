---
import { Image } from "astro:assets";

export interface Props {
  title: string;
  image: ImageMetadata;
  isGordon?: boolean;
}

const { title, image, isGordon } = Astro.props;
---

<style>
  .course-hero {
    width: 100%;
    background-color: var(--color-bg);
    padding: 2rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-border);
  }

  .label {
    font-size: 1.25rem;
    color: var(--color-base);
    font-family: var(--text-body);
    text-transform: capitalize;
    font-weight: 300;
  }

  .label-gordon {
    font-weight: 400;
  }

  .title {
    font-size: 4rem;
    font-family: var(--text-serif);
    color: var(--color-foreground);
    font-weight: 700;
  }

  .img-wrapper {
    overflow: hidden;
    border-radius: 999px;
    width: 290px;
    height: 290px;
    flex-shrink: 0;
    border: 1px solid var(--color-primary);
  }

  .img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<div class="course-hero">
  <div>
    <p class="label">Corso</p>
    <h2 class="title">{title}</h2>
    {isGordon && <p class="label label-gordon">con Luca Mauri</p>}
  </div>
  <div class="img-wrapper">
    <Image src={image} alt={`Foto del corso di ${title}`} width={290} height={290} />
  </div>
</div>
