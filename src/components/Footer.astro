---
import Link from "./Link.astro";
import Image from "astro/components/Image.astro";
import logo from "../assets/logo.png";
const pathname = Astro.url.pathname;
const currentYear = new Date().getFullYear();

const navLinks = [
  { href: `/news/${currentYear}`, label: "News" },
  { href: "/statuto", label: "Statuto" },
  { href: "/team", label: "Il Team" },
  {
    href: pathname === "/" ? "#courses-section" : "/#courses-section",
    label: "Corsi",
  },
];

const courseLinks = [
  { href: "/corsi/basso", label: "Basso" },
  { href: "/corsi/batteria", label: "Batteria" },
  { href: "/corsi/canto", label: "Canto" },
  { href: "/corsi/chitarra", label: "Chitarra" },
  { href: "/corsi/tastiera", label: "Tastiera" },
  { href: "/corsi/gordon", label: "Corso GORDON" },
];

const contacts = [
  "associazionemusicadiffusa@gmail.com",
  "+39 3392044740",
  "Via Provinciale, 15, 20042 - Pessano con Bornago (MI)",
];
---

<style>
  footer {
    padding: 4rem 1.5rem;
    background:
      linear-gradient(var(--color-bg-light), var(--color-bg-light)) top / 100%
        100% no-repeat,
      var(--color-bg);
    display: flex;
    flex-direction: column;
    gap: 3rem;
    position: relative;
    z-index: 20;
  }
  .bottom-nav {
    margin: auto;
  }
  .bottom-nav-list {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      "brand"
      "nav-title"
      "nav-list"
      "corsi-title"
      "corsi-list"
      "contatti-title"
      "contatti-list";
    column-gap: 1.5rem;
    row-gap: 0.75rem;
    align-items: start;
  }
  .bottom-nav-list ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-main-title-container {
    position: relative;
    bottom: 4px;
    grid-area: brand;
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
  }
  .nav-title {
    grid-area: nav-title;
  }
  .nav-list {
    grid-area: nav-list;
  }
  .corsi-title {
    grid-area: corsi-title;
  }
  .corsi-list {
    grid-area: corsi-list;
  }
  .contatti-title {
    grid-area: contatti-title;
  }
  .contatti-list {
    grid-area: contatti-list;
  }
  @media screen and (min-width: 768px) {
    .bottom-nav-list {
      grid-template-columns: repeat(2, 1fr);
      grid-template-areas:
        "brand brand"
        "nav-title corsi-title"
        "nav-list corsi-list"
        "contatti-title contatti-title"
        "contatti-list contatti-list";
    }
  }
  @media screen and (min-width: 1200px) {
    .bottom-nav-list {
      grid-template-columns: repeat(4, max-content);
      grid-template-areas:
        "brand nav-title corsi-title contatti-title"
        "brand nav-list corsi-list contatti-list";
      row-gap: 0.5rem;
    }
  }
  .bottom-nav-title {
    font-size: 1rem;
    font-weight: 600;
    font-family: var(--text-body);
  }
  .main-title {
    font-size: 1.25rem;
  }
  .bottom-nav-link {
    font-size: 0.875rem;
    font-weight: 400;
  }
  .rights-container {
    padding-top: 2rem;
    text-align: center;
    border-top: 1px solid var(--color-base);
    max-width: var(--max-content-w);
    margin: auto;
  }
  .rights {
    font-size: 0.875rem;
  }

  .logo {
    position: relative;
    bottom: 4px;
  }
</style>
<footer>
  <nav class="bottom-nav">
    <div class="bottom-nav-list">
      <div class="nav-main-title-container">
        <Image
          class="logo"
          src={logo}
          alt="Musica Diffusa logo"
          height={32}
          width={32}
        />
        <h4 class="bottom-nav-title main-title">Musica Diffusa</h4>
      </div>
      <h4 class="bottom-nav-title nav-title">Navigazione</h4>
      <h4 class="bottom-nav-title corsi-title">Corsi</h4>
      <h4 class="bottom-nav-title contatti-title">Contatti</h4>

      <ul class="nav-list">
        {
          navLinks.map((link) => (
            <li>
              <Link href={link.href} class="bottom-nav-link">
                {link.label}
              </Link>
            </li>
          ))
        }
      </ul>
      <ul class="corsi-list">
        {
          courseLinks.map((link) => (
            <li>
              <Link href={link.href} class="bottom-nav-link">
                {link.label}
              </Link>
            </li>
          ))
        }
      </ul>
      <ul class="contatti-list">
        {
          contacts.map((contact) => (
            <li>
              <p class="bottom-nav-link">{contact}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
  <div class="rights-container">
    <p class="rights">
      © 2026 Musica Diffusa - P.IVA n. 13068160962 - Tutti i diritti riservati.
    </p>
  </div>
</footer>
