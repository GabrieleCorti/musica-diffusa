---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  active?: boolean;
}
const { active, class: className, ...attrs } = Astro.props;
---

<style>
  a {
    font-size: var(--text-body);
  }
  .active {
    color: var(--color-primary);
  }
  a:visited {
    color: var(--color-base);
  }
</style>
<a class:list={["text-link", { active: Boolean(active) }, className]} {...attrs}
  ><slot /></a
>
