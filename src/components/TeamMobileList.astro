---
import TeamListItem from "./TeamListItem.astro";

export interface Props {
  teachers: {
    name: string;
    proPic: ImageMetadata;
    instrument: string;
    href: string;
  }[];
}
const { teachers } = Astro.props;
---

<style>
  .mobile-team {
    display: block;
  }
  @media screen and (min-width: 768px) {
    .mobile-team {
      display: none;
    }
  }
  .mobile-team-header {
    text-align: left;
    padding: 6.5rem 1.5rem 2rem;
  }
  .second-title {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }
  h2 {
    font-size: clamp(2.25rem, 12vw, 3rem);
    font-family: var(--text-body);
  }
  .team-list {
    display: flex;
    flex-direction: column;
    padding: 0 1.5rem;
  }
</style>
<div class="mobile-team">
  <div class="mobile-team-header">
    <p class="second-title">INCONTRA</p>
    <h2>IL TEAM</h2>
  </div>
  <div class="team-list">
    {teachers.map((teacher) => <TeamListItem {...teacher} />)}
  </div>
</div>
<script>
  const rows = document.querySelectorAll<HTMLElement>(".team-list .team-row");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 },
  );

  rows.forEach((row) => observer.observe(row));
</script>
