<style is:global>
  /* Variable */
  :root {
    --color-primary: #be233a;
    --color-base: #a6a6a6;
    --color-bg: #181818;
    --color-foreground: #fafafa;
    --color-bg-light: #38383830;
    --color-border: #333333;
    --text-body: "Barlow", Arial, Helvetica, sans-serif;
    --text-serif: "Inria Serif", Arial, Helvetica, sans-serif;
    --max-content-w: 80rem;
    --max-text-w: 42rem;
  }
  /* General */
  * {
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }
  html {
    scroll-behavior: smooth;
  }
  /* Section */
  body {
    background-color: var(--color-bg);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  /* Element */
  main,
  footer {
    width: 100%;
  }
  main {
    padding: 0;
  }
  .page-content {
    width: 100%;
    max-width: var(--max-content-w);
    padding: 0 1.5rem;
    margin: 0 auto;
  }
  ul,
  ol {
    list-style: none;
  }
  a {
    cursor: pointer;
    text-decoration: none;
  }
  a:disabled {
    cursor: no-drop;
  }
  a,
  p,
  span {
    font-family: var(--text-body);
    color: var(--color-base);
  }
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--text-serif);
    color: var(--color-foreground);
  }
  /* Common classes */
  .max-content-w {
    max-width: var(--max-content-w);
  }
  .max-text-w {
    max-width: var(--max-text-w);
  }
  .text-link {
    color: var(--color-base);
    font-family: var(--text-body);
    transition: color 170ms ease-in-out;
  }
  .text-link:hover {
    color: var(--color-primary);
    transition: color 170ms ease-in-out;
  }
  .divider {
    background-color: var(--color-base);
    width: 100%;
    height: 1px;
  }
  .icon-primary {
    color: var(--color-primary);
  }
  @media screen and (min-width: 1200px) {
    .page-content {
      padding: 0;
    }
  }
</style>
