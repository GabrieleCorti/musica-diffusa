---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import photo1 from "../assets/hero/hero_1.png";
import photo2 from "../assets/hero/hero_2.png";
import photo3 from "../assets/hero/hero_3.png";
---

<style>
  .hero {
    width: 100%;
    height: calc(100vh - 2rem);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5rem 1.5rem;
    background: radial-gradient(
      circle at 30% 40%,
      color-mix(in srgb, var(--color-primary) 14%, var(--color-bg)) 0%,
      var(--color-bg) 60%
    );
    overflow: hidden;
  }
  .hero-content {
    width: 100%;
    max-width: var(--max-content-w);
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    text-align: center;
  }
  .hero-content.small {
    display: flex;
  }
  .disc-cluster {
    position: relative;
    flex-shrink: 0;
    width: 180px;
    height: 180px;
    z-index: 1;
  }

  .logo-wrap-small {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-wrap {
    position: absolute;
    top: 60%;
    left: 35%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
  }

  .logo-wrap :global(img) {
    object-fit: contain;
    filter: drop-shadow(
      0 0 40px color-mix(in srgb, var(--color-primary) 45%, transparent)
    );
  }
  .float-photo {
    position: absolute;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--color-bg);
    box-shadow: 0 0 28px 0
      color-mix(in srgb, var(--color-primary) 35%, transparent);
    z-index: 2;
  }
  .float-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* filter: grayscale(1) contrast(1.05); */
  }
  .float-photo.top {
    top: -12%;
    left: -13%;
  }
  .float-photo.left {
    bottom: -30%;
    left: -51%;
  }
  .float-photo.right {
    bottom: -45%;
    right: -30%;
  }
  .hero-title {
    position: relative;
    z-index: 2;
    font-family: var(--text-body);
    font-weight: 800;
    font-size: 2rem;
    line-height: 1.25;
    color: var(--color-foreground);
  }
  .hero-title .accent {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.08em;
  }
  .hero-title .soft {
    font-family: var(--text-serif);
    font-weight: 400;
    font-style: italic;
  }

  @media screen and (min-width: 640px) {
    .hero {
      padding: 6rem 1.5rem;
    }
    .hero-title {
      font-size: 3.25rem;
    }
    .disc-cluster {
      width: 280px;
      height: 280px;
    }
    .float-photo {
      width: 125px;
      height: 125px;
    }
  }

  @media screen and (min-width: 900px) {
    .hero-content.small {
      display: none;
    }
    .hero-content:not(.small) {
      display: flex;
    }
    .hero-content {
      flex-direction: row;
      justify-content: center;
      text-align: left;
    }
    .hero-title {
      font-size: 4rem;
      margin-left: -4rem;
    }
    .disc-cluster {
      width: 320px;
      height: 320px;
    }
    .float-photo {
      width: 140px;
      height: 140px;
    }
  }
</style>

<section class="hero">
  <div class="hero-content small">
    <div class="logo-wrap-small">
      <Image
        fetchpriority="high"
        loading="eager"
        src={logo}
        alt="Musica Diffusa logo"
        width={90}
        height={90}
      />
    </div>
    <h1 class="hero-title">
      Dove la musica<br />
      si fa <span class="accent">diffusa</span>,<br />
      la condivisione<br />
      diventa <span class="soft">futuro</span>
    </h1>
  </div>
  <div class="hero-content">
    <div class="disc-cluster">
      <div class="float-photo top">
        <Image src={photo1} alt="" width={140} height={140} />
      </div>
      <div class="float-photo left">
        <Image src={photo2} alt="" width={140} height={140} />
      </div>
      <div class="float-photo right">
        <Image src={photo3} alt="" width={140} height={140} />
      </div>
      <div class="logo-wrap">
        <Image
          fetchpriority="high"
          loading="eager"
          src={logo}
          alt="Musica Diffusa logo"
          width={520}
          height={520}
        />
      </div>
    </div>
    <h1 class="hero-title">
      Dove la musica<br />
      si fa <span class="accent">diffusa</span>,<br />
      la condivisione<br />
      diventa <span class="soft">futuro</span>
    </h1>
  </div>
</section>
