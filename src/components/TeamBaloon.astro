---
import { Image } from "astro:assets";
import Music from "@lucide/astro/icons/music-2";

export interface Props {
  name: string;
  proPic: ImageMetadata;
  href?: string;
  instrument: string;
  class?: string;
}
const { name, proPic, href, instrument, class: customClass } = Astro.props;
---

<style>
  .teacher-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    /* transition: transform 0.3s ease, box-shadow 0.3s ease; */
  }
  .img-wrapper {
    max-width: 200px;
    aspect-ratio: 1;
    border-radius: 1000px;
    border: 1px solid var(--color-primary);
    overflow: hidden;
    width: min-content;

    /*  -webkit-box-shadow: 0px 0px 35px 5px rgba(190, 35, 58, 0.22);
    box-shadow: 0px 0px 35px 5px rgba(190, 35, 58, 0.22); */
  }
  .teacher-name {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-primary);
  }
  p {
    font-size: 1.125rem;
    color: var(--color-secondary);
  }
  .musical-note {
    color: var(--color-primary);
    width: 12px;
    aspect-ratio: square;
  }

  .musical-note {
    color: var(--color-primary);
    width: 12px;
    aspect-ratio: square;
  }
</style>
<a class="teacher-link" href={href}>
  <div class:list={["img-wrapper", customClass]}>
    <Image
      src={proPic}
      alt={`Foto profilo di ${name}`}
      height={200}
      width={200}
    />
  </div>
  <h4 class="teacher-name">{name}</h4>
  <p><Music class="musical-note" /> {instrument}</p>
</a>
