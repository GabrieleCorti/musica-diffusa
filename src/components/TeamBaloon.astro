---
import { Image } from "astro:assets";
import Music from "@lucide/astro/icons/music-2";

export interface Props {
  name: string;
  proPic: ImageMetadata;
  href?: string;
  instrument: string;
  class?: string;
}
const { name, proPic, href, instrument, class: customClass } = Astro.props;
---

<style>
  .teacher-link {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .teacher-name {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-primary);
    font-family: var(--text-body);
  }
  p {
    font-size: 1.125rem;
    color: var(--color-secondary);
    display: flex;
    align-items: center;
  }
  .musical-note {
    color: var(--color-primary);
    width: 16px;
    aspect-ratio: 1;
  }
</style>
<a class="teacher-link" href={href}>
  <div class:list={["avatar", customClass]}>
    <Image
      src={proPic}
      alt={`Foto profilo di ${name}`}
      height={200}
      width={200}
      fit="cover"
      position="center"
    />
  </div>
  <h4 class="teacher-name">{name}</h4>
  <p><Music class="musical-note" /> {instrument}</p>
</a>
