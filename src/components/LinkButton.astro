---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  type?: "primary" | "foreground";
}
const { type = "primary", class: className, ...rest } = Astro.props;
---

<style>
  .link-button {
    padding: 0.75rem 1rem;
    font-weight: 600;
    display: block;
    width: fit-content;
  }
  .primary {
    background-color: var(--color-primary);
    color: var(--color-foreground);
    border-radius: 6px;
  }
  .foreground {
    color: var(--color-primary);
    background-color: var(--color-foreground);
    border-radius: 999px;
  }
</style>
<a
  class:list={[
    "link-button",
    { primary: type === "primary", foreground: type === "foreground" },
    className,
  ]}
  {...rest}
>
  <slot />
</a>
